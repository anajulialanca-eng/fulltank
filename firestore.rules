rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(garageId) { return signedIn() && exists(/databases/$(database)/documents/garages/$(garageId)/members/$(request.auth.uid)); }
    function admin(garageId) { return member(garageId) && get(/databases/$(database)/documents/garages/$(garageId)/members/$(request.auth.uid)).data.role == 'admin'; }

    match /users/{uid} {
      allow create, read, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    match /garages/{garageId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if member(garageId);
      allow update, delete: if admin(garageId);

      match /members/{uid} {
        allow read: if member(garageId);
        allow create: if signedIn() && request.auth.uid == uid;
        allow update, delete: if admin(garageId) || (signedIn() && request.auth.uid == uid);
      }
      match /vehicles/{id} {
        allow read, create, update: if member(garageId);
        allow delete: if admin(garageId);
      }
      match /fuelings/{id} {
        allow read, create: if member(garageId);
        allow update: if member(garageId) && (admin(garageId) || resource.data.createdBy == request.auth.uid);
        allow delete: if member(garageId) && (admin(garageId) || resource.data.createdBy == request.auth.uid);
      }
      match /maintenance/{id} {
        allow read, create: if member(garageId);
        allow update: if member(garageId) && (admin(garageId) || resource.data.createdBy == request.auth.uid);
        allow delete: if member(garageId) && (admin(garageId) || resource.data.createdBy == request.auth.uid);
      }
    }
  }
}
